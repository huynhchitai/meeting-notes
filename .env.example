# ── Google Cloud / Vertex AI ──────────────────────────────────────────────────
# GCP project that has the Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region to use for Vertex AI calls. Defaults to us-central1 if not set.
GOOGLE_CLOUD_REGION=us-central1

# Option A (local dev): path to your service-account JSON key file.
# The key file must NEVER be committed — it is listed in .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-key.json

# Option B (Vercel / CI): paste the entire service-account JSON as a single-line
# string. Takes priority over GOOGLE_APPLICATION_CREDENTIALS if both are set.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Create a free database at https://console.upstash.com
# If these are not set, rate limiting degrades to a no-op (all requests pass).
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
